// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ── USER MODEL ───────────────────────────────────────────
model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  phone            String   @unique
  email            String?
  password         String
  role             String   // e.g. 'member' | 'gym_owner' | 'vendor' | 'admin'
  gymId            String?  @db.ObjectId
  avatar           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── MEMBER MODEL ─────────────────────────────────────────
model Member {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique @db.ObjectId
  name             String
  phone            String   @unique
  email            String?
  gymId            String   @db.ObjectId
  gender           String
  dob              String
  height           Float?
  weight           Float?
  bmi              Float?
  goal             String
  medicalIssues    String?
  emergencyContact String?
  emergencyPhone   String?
  planId           String?  @db.ObjectId
  status           String   // 'active' | 'expired' | 'pending'
  joinDate         String
  expiryDate       String
  trainerId        String?  @db.ObjectId
  photo            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── GYM MODEL ────────────────────────────────────────────
model Gym {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  address          String
  city             String
  phone            String
  email            String?
  rating           Float    @default(5.0)
  status           String   @default("approved") // 'pending' | 'approved' | 'suspended'
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── VENDOR STORE MODEL ───────────────────────────────────
model VendorStore {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @unique @db.ObjectId
  storeName         String
  ownerName         String
  category          String   // e.g. 'supplement_store'
  gstNumber         String?
  phone             String
  email             String
  address           String
  city              String
  state             String
  pincode           String
  upiId             String?
  bankAccount       String?
  ifsc              String?
  status            String   // 'pending' | 'approved' | 'suspended'
  avatar            String?  // initials/emoji
  shopImage         String   @default("🏪")
  rating            Float    @default(4.7)
  totalReviews      Int      @default(0)
  joinDate          String
  tagline           String?
  description       String?
  deliveryMethods   String[]
  freeDeliveryAbove Float    @default(0)
  deliveryCharges   Float    @default(0)
  kycDocuments      Json?    // Array of KYC documents [{ type, label, number, status, uploadedAt, rejectionReason }]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── VENDOR PRODUCT MODEL ─────────────────────────────────
model VendorProduct {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  vendorId          String   @db.ObjectId
  name              String
  brand             String
  category          String   // e.g. 'protein'
  description       String?
  ingredients       String?
  nutritionFacts    String?
  weight            String   // '1kg', '2kg', etc.
  flavours          String[]
  images            String[] // Emojis / URLs
  mrp               Float
  price             Float    // Member / default price
  ownerPrice        Float    // Special price for gym owners
  memberPrice       Float    // Regular member price
  margin            Float    @default(0) // Margin percentage
  discount          Float    @default(0) // Member discount %
  ownerDiscount     Float    @default(0) // Owner discount %
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  expiryDate        String?
  rating            Float    @default(0)
  reviews           Int      @default(0)
  sold              Int      @default(0)
  isActive          Boolean  @default(true)
  tags              String[]
  offer             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── VENDOR ORDER MODEL ───────────────────────────────────
model VendorOrder {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  vendorId        String   @db.ObjectId
  buyerId         String   @db.ObjectId
  buyerName       String
  buyerPhone      String
  buyerType       String   // 'member' | 'gym_owner'
  items           Json     // Array of OrderItems [{ productId, productName, qty, price, total }]
  total           Float
  deliveryCharge  Float    @default(0)
  discount        Float    @default(0)
  status          String   // 'new' | 'accepted' | 'packed' | 'shipped' | 'delivered' | 'cancelled'
  deliveryMethod  String   // 'self' | 'local' | 'partner'
  deliveryAddress String
  paymentMethod   String   // 'upi' | 'cash_on_delivery' | 'online'
  orderedAt       String
  updatedAt       String
  trackingId      String?
  notes           String?
  createdAt       DateTime @default(now())
}

// ── NOTIFICATION MODEL ───────────────────────────────────
model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  target    String   // 'admin' | 'gym_owner' | 'member' | 'all'
  gymId     String?  @db.ObjectId // optional associated gym ID
  userId    String?  @db.ObjectId // optional target user ID
  type      String   // 'push' | 'system'
  date      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── MEMBERSHIP PLAN MODEL ────────────────────────────────
model MembershipPlan {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  gymId        String   @db.ObjectId
  name         String   // e.g. 'Starter', 'Gold Annual', 'Quarterly Pro'
  price        Float
  durationDays Int      // e.g. 30, 90, 180, 365
  description  String?
  features     String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── ATTENDANCE MODEL ─────────────────────────────────────
model Attendance {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId     String   @db.ObjectId
  gymId        String   @db.ObjectId
  checkInTime  DateTime @default(now())
  checkOutTime DateTime?
  date         String   // YYYY-MM-DD
  method       String   // 'qr_code' | 'manual' | 'biometric'
  status       String   @default("granted") // 'granted' | 'expired_rejected'
  createdAt    DateTime @default(now())
}

// ── GYM CLASS MODEL ──────────────────────────────────────
model GymClass {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  gymId       String   @db.ObjectId
  trainerId   String?  @db.ObjectId
  trainerName String?
  title       String   // e.g. 'Morning Power Yoga', 'HIIT Crossfit'
  category    String   // 'yoga' | 'crossfit' | 'zumba' | 'spinning' | 'boxing'
  description String?
  dayOfWeek   String   // 'Monday' | 'Tuesday' etc. or 'Daily'
  startTime   String   // '07:00 AM'
  endTime     String   // '08:00 AM'
  capacity    Int      @default(20)
  bookedSeats Int      @default(0)
  room        String?  // 'Studio A', 'Main Floor'
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── CLASS BOOKING MODEL ──────────────────────────────────
model ClassBooking {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  classId     String   @db.ObjectId
  memberId    String   @db.ObjectId
  gymId       String   @db.ObjectId
  bookingDate String   // YYYY-MM-DD
  status      String   @default("confirmed") // 'confirmed' | 'cancelled' | 'attended'
  createdAt   DateTime @default(now())
}

// ── WORKOUT PLAN MODEL ───────────────────────────────────
model WorkoutPlan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId    String   @db.ObjectId
  gymId       String   @db.ObjectId
  trainerId   String?  @db.ObjectId
  title       String   // 'Push / Pull / Legs Split'
  level       String   @default("Intermediate") // 'Beginner' | 'Intermediate' | 'Advanced'
  goal        String   // 'Muscle Gain' | 'Weight Loss'
  days        Json     // Array of days with exercises [{ dayName, exercises: [{ name, sets, reps, targetMuscle, videoUrl }] }]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── WORKOUT LOG MODEL ────────────────────────────────────
model WorkoutLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId    String   @db.ObjectId
  gymId       String   @db.ObjectId
  workoutName String
  date        String   // YYYY-MM-DD
  durationMin Int      @default(45)
  caloriesBurned Int   @default(300)
  completedSets Json   // Details of completed sets and weights
  createdAt   DateTime @default(now())
}

// ── DIET PLAN MODEL ──────────────────────────────────────
model DietPlan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId    String   @db.ObjectId
  gymId       String   @db.ObjectId
  trainerId   String?  @db.ObjectId
  title       String   // 'High Protein Lean Bulk'
  targetCalories Int   @default(2400)
  proteinGrams   Int   @default(150)
  carbsGrams     Int   @default(250)
  fatsGrams      Int   @default(65)
  waterLiters    Float @default(3.5)
  meals       Json     // Array of meals [{ mealType, time, name, calories, items: [] }]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── PAYMENT RECORD MODEL ─────────────────────────────────
model PaymentRecord {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId      String   @db.ObjectId
  gymId         String   @db.ObjectId
  planId        String?  @db.ObjectId
  amount        Float
  paymentMethod String   // 'cash' | 'upi' | 'razorpay' | 'card'
  status        String   // 'completed' | 'pending' | 'failed'
  invoiceNumber String   @unique
  date          String   // YYYY-MM-DD
  notes         String?
  createdAt     DateTime @default(now())
}

// ── EXERCISE MASTER MODEL ─────────────────────────────────
model Exercise {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String   @unique
  slug                String   @unique
  category            String   // 'Chest' | 'Back' | 'Shoulders' | 'Biceps' | 'Triceps' | 'Legs & Glutes' | 'Calves' | 'Abs & Core' | 'Full Body' | 'Cardio' | 'Stretching & Mobility'
  primaryMuscle       String
  secondaryMuscles    String[]
  difficulty          String   // 'Beginner' | 'Intermediate' | 'Advanced'
  equipment           String[]
  exerciseType        String   @default("Strength") // 'Strength' | 'Cardio' | 'Stretching' | 'Plyometrics'
  movementPattern     String?  // 'Push' | 'Pull' | 'Squat' | 'Hinge' | 'Lunge' | 'Carry' | 'Rotation'
  instructions        String[]
  benefits            String[]
  safetyTips          String[]
  commonMistakes      String[]
  beginnerSets        Int      @default(3)
  beginnerReps        String   @default("10-12")
  beginnerRestSec     Int      @default(60)
  intermediateSets    Int      @default(4)
  intermediateReps    String   @default("8-10")
  intermediateRestSec Int      @default(90)
  advancedSets        Int      @default(5)
  advancedReps        String   @default("5-8")
  advancedRestSec     Int      @default(120)
  restTime            String   @default("60s")
  caloriesBurned      Int      @default(80)
  imageUrl            String?
  videoUrl            String?
  thumbnailUrl        String?
  isPremium           Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}


