# FitCore Backend — Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials

# ── DATABASE ─────────────────────────────────────────────
DATABASE_URL="mongodb://localhost:27017/fitcore?directConnection=true"

# ── SECURITY ──────────────────────────────────────────────
# Generate a random 64/128 hex character secret for JWT signing in production
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE

# ── CORS ─────────────────────────────────────────────────
# Comma-separated allowed web origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── SERVER ───────────────────────────────────────────────
PORT=7000
NODE_ENV=development
