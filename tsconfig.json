{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["es2019"],
    "allowJs": true,
    "jsx": "react-native",
    "noEmit": true,
    "isolatedModules": true,
    "strict": false,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "*": ["./FitCore/*"]
    }
  },
  "include": ["FitCore/**/*.ts", "FitCore/**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "**/dist", "**/build"]
}
