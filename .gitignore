# ==============================================================================
# FitCore Root .gitignore - Prevent Data, Secret, Binary & Document Leaks
# ==============================================================================

# ── Standalone Projects (fitcore-web & FitCoreB live in their own repos) ────
FitCoreB/
fitcore-web/

# ── Local Database Storage (CRITICAL: NEVER COMMIT DB FILES) ────────────────
mongodb_data/
*.wt
*.bson
*.lock
WiredTiger*
diagnostic.data/
journal/
_tmp/

# ── Secrets & Environment Variables ─────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local
*.env

# ── Confidential Documents, PRDs, Financials & Design Files ──────────────────
Documents/
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
fitcore_admin_doc.html
FitCore_Admin_Complete_Documentation.pdf
FitCore_Product_Requirements_Document.pdf

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Build Outputs & Caches ───────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Prisma Generated Artifacts & SQLite Temp DBs ─────────────────────────────
/generated/
/generated/prisma/
prisma/migrations/dev.db
prisma/migrations/dev.db-journal
*.db
*.db-journal
*.sqlite
*.sqlite3

# ── File Uploads & Temp Storage ──────────────────────────────────────────────
uploads/
public/uploads/
tmp/
temp/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
combined.log
error.log

# ── Mobile (React Native / iOS / Android) ────────────────────────────────────
.metro-health-check*
*.jsbundle
**/Pods/
/vendor/bundle/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
.kotlin/
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# ── IDE & Operating System Files ────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ── Testing & Coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/
jest-results.xml

# Environment & Secrets
.env
.env.*
*.env

# Documentation & Requirements Folders (Prevent leaking PRD/Architecture files)
01_Requirements/
02_PRD/
03_User_Flows/
04_UI_UX/
05_Technical_Documentation/
06_Database/
07_API/
08_Web/
09_Mobile/
10_Testing/
11_Deployment/
12_Maintenance/
Documents/
*.pdf
*.docx
*.xlsx

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
